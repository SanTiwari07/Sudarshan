# Copy to .env and fill in. .env is gitignored and must never be committed.

# ─── Required ─────────────────────────────────────────────────────────────────
# The backend refuses to start without this. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ─── Admin bootstrap ──────────────────────────────────────────────────────────
# Seeded on first boot only. If ADMIN_PASSWORD is left blank, a random password
# is generated and printed once to the backend log — capture it from there.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Threat intelligence (optional; correlation is skipped when unset) ────────
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=

# ─── Sandbox (Dynamic Analysis) ───────────────────────────────────────────────
# Provider: genymotion (default) | android_studio | corellium | waydroid | physical
SANDBOX_PROVIDER=genymotion
# Genymotion VM endpoint visible from the analysis containers. Obtain it from
# `adb devices -l` (the serial before `:5555`); do not use host.docker.internal.
ADB_HOST=
ADB_PORT=5555
# Pin a device when multiple are online (Genymotion often shows as IP:port)
DEVICE_SERIAL=
FRIDA_PORT=27055
SUDARSHAN_FRIDA_PORT=27055
SUDARSHAN_FRIDA_BIN=sudarshan_agent_srv
AUTO_CONNECT=true
ROOT_REQUIRED=true
# Optional: path to Genymotion's bundled adb.exe
# GENYMOTION_ADB=C:\Program Files\Genymobile\Genymotion\tools\adb.exe

# ─── Optional ─────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_EXPIRE_HOURS=12
MOBSF_HOST=
MOBSF_API_KEY=
# Shared secret between backend and analysis-engine (set in production).
ANALYSIS_ENGINE_INTERNAL_TOKEN=
# Set to production to enable stricter startup checks.
SUDARSHAN_ENV=
# Disable gateway rate limits during local pytest (optional).
SUDARSHAN_RATE_LIMIT_DISABLED=
# Dynamic-analysis pacing. Raise the scale if the sandbox is slow and the
# app crashes under automation (2.0 = every UI delay doubled).
SUDARSHAN_ACTION_DELAY_SCALE=1.0
SUDARSHAN_APP_OPEN_SETTLE=8.0
