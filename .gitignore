.pytest_cache/

# Node.js
node_modules/
npm-debug.log
yarn-error.log
yarn-debug.log
.pnpm-debug.log
# Lockfiles are COMMITTED on purpose - without one, `npm install` can resolve
# different dependency versions from the same commit, so builds are not
# reproducible and a compromised transitive dep cannot be pinned out.

# Build output (frontend)
dist/
build/
out/
.next/

