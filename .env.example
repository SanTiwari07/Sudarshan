# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env        (start.ps1 does this automatically)
#
# Validate the result before a run - it reports every setting below that
# silently degrades dynamic analysis:
#
#   python scripts/preflight.py --container
#
# NOTE ON PER-SERVICE OVERRIDES
# analysis-engine/.env is an OPTIONAL override layered on top of this file
# (docker-compose declares it required: false). A fresh clone has none, and
# nothing needs one - every value the engine reads is here.

# ─── Required ─────────────────────────────────────────────────────────────────
# The backend refuses to start without this. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ─── Admin bootstrap ──────────────────────────────────────────────────────────
# Seeded on first boot only. If ADMIN_PASSWORD is left blank, a random password
# is generated and printed once to the backend log - capture it from there.
# BOI Hackathon demo (recommended):
#   ADMIN_USERNAME=admin
#   ADMIN_PASSWORD=BOI@Admin2026!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── BOI Hackathon demo users (optional) ─────────────────────────────────────
# Creates soclead (soc_lead) and analyst1 (analyst) on startup if missing.
# SUDARSHAN_SEED_DEMO_USERS=true
# DEMO_SOCLEAD_USERNAME=soclead
# DEMO_SOCLEAD_PASSWORD=Sudarshan@SOC2026
# DEMO_ANALYST_USERNAME=analyst1
# DEMO_ANALYST_PASSWORD=Sudarshan@Analyst2026
# Optional alternate logins (boi_admin, boi_soclead, boi_analyst):
# DEMO_SEED_BOI_ALIASES=true

# ─── AI ───────────────────────────────────────────────────────────────────────
# NOT optional in practice. Without a key the agentic planner disables itself
# and the deterministic FallbackPlanner takes over, so the UI explorer performs
# far fewer and much shallower taps - the run completes but the evidence is
# thin. Key: https://aistudio.google.com/app/apikey (starts with 'AIzaSy').
# Preferred: Gemini 3.x Flash on the primary key. If that key is exhausted, the
# manager fails over to Gemini 2.5 Flash on the fallback key. Do not load-balance.
GEMINI_PRIMARY_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_PRIMARY_COOLDOWN_SECONDS=60
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=0.5

# Legacy aliases (still used as the primary provider when PRIMARY_* is unset):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Output budget for one planner call. Covers the model's internal reasoning as
# well as the answer, which is why 512 is not enough on a thinking model:
# measured on gemini-3.6-flash, 358 of 512 tokens went to thinking before any
# JSON was emitted, so the action was truncated mid-string and the planner fell
# back to the deterministic one on every call. Thinking cannot be switched off
# on that model (thinking_budget=0 returns 400).
SUDARSHAN_AGENT_MAX_OUTPUT_TOKENS=2048

# ─── Threat intelligence (optional; correlation is skipped when unset) ────────
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=

# Requests/minute budget for scripts/virustotal_crosscheck.py, which benchmarks
# the corpus verdicts against VirusTotal. 4 is the public-key quota; raise it
# for a premium key. Exceeding the quota returns HTTP 429, which the harness
# records as an ERROR row rather than as a clean sample.
VIRUSTOTAL_RATE_LIMIT_PER_MIN=4

# ─── Permission investigation ─────────────────────────────────────────────────
# Grant every declared runtime permission via `pm grant` before the app starts.
#
# ON by default, and for a real reason: a legacy-targetSdk app cold-starts into
# ReviewPermissionsActivity, which leaves `pidof` empty and breaks the launch
# ladder. Turning it off trades a permission dialog for a failed run.
#
# The cost is that Android shows no runtime permission dialog for a permission
# already held, so the investigation cannot observe which permissions the sample
# would actually ask for - and asking is a behaviour, whereas declaring is only
# an intention. Set to 0 to observe the real request flow.
#
# Changing this changes what the sandbox sees and therefore BFCI inputs.
SUDARSHAN_PREGRANT_PERMISSIONS=1

# ─── Sandbox: which emulator ──────────────────────────────────────────────────
# Provider: auto (default) | genymotion | android_avd | android_studio | physical
# auto = discover via `adb devices -l` and fingerprint Genymotion / AVD / physical
ANDROID_SANDBOX_PROVIDER=auto
SANDBOX_PROVIDER=auto
# Optional: pin an exact ADB serial (Genymotion IP:port, emulator-5554, or USB id)
# ANDROID_DEVICE_SERIAL=
# DEVICE_SERIAL=
# Optional: pin an Android Studio AVD name when starting via setup_dynamic_analysis.py
# SUDARSHAN_AVD=
# Optional: path to Genymotion's bundled adb.exe
# GENYMOTION_ADB=C:\Program Files\Genymobile\Genymotion\tools\adb.exe

# ─── Sandbox: how the CONTAINERS reach that emulator ──────────────────────────
# This is the setting that most often differs between machines, because the
# emulator runs on the host while the analysis engine runs in a container.
#
# Route A (default, Docker Desktop on Windows/macOS)
#   The containers talk to the HOST's adb server. Docker Desktop proxies
#   host.docker.internal to host loopback, so a server bound to 127.0.0.1:5037
#   is reachable. Nothing to configure - leave ADB_HOST empty.
#
# Route B (Linux Docker, or a Genymotion VM on a host-only network)
#   host.docker.internal reaches the host's real interface, NOT its loopback,
#   so route A fails. Point the containers straight at the device instead:
#     - Genymotion: ADB_HOST=<VM IP>          (e.g. 192.168.56.101)
#     - AVD:        run `adb tcpip 5555` on the host first, then set ADB_HOST
#   Never set ADB_HOST=host.docker.internal for Genymotion; it is rejected.
#
# Whichever route is active, `adb forward` binds its port wherever the ADB
# SERVER runs. The Frida client follows the same host automatically - see
# sudarshan_core.sandbox.config.frida_client_hosts().
ADB_HOST=
ADB_PORT=5555
# Where the containers find an ADB server. Compose defaults this to
# tcp:host.docker.internal:5037 (route A). Set to tcp:127.0.0.1:5037 to make a
# container use its own adb server (route B).
# ADB_SERVER_SOCKET=tcp:host.docker.internal:5037

# ─── Sandbox: Frida ───────────────────────────────────────────────────────────
FRIDA_PORT=27055
SUDARSHAN_FRIDA_PORT=27055
SUDARSHAN_FRIDA_BIN=sudarshan_agent_srv
# frida-server is ~106 MB - over GitHub's file limit - so tools/ is gitignored
# and a fresh clone has no binary. The ABI-matched build is downloaded on first
# use and cached in tools/, which compose bind-mounts into the engine at
# /opt/frida-cache so the download survives container rebuilds.
# FRIDA_VERSION=17.16.4
# FRIDA_SERVER_DIR=
# Set to 0 on an air-gapped host; you must then place the binary in tools/
# yourself and the error message will tell you the exact filename expected.
# SUDARSHAN_FRIDA_AUTO_DOWNLOAD=1
AUTO_CONNECT=true
ROOT_REQUIRED=true
# Loopback-only Frida on the guest (reachable via adb forward). Never 0.0.0.0.
FRIDA_LISTEN_HOST=127.0.0.1
# Fail closed on misconfigured ADB (set true in production; implied when SUDARSHAN_ENV=production).
# SANDBOX_CONTAINMENT_STRICT=true
# Never enable in production
# SUDARSHAN_ALLOW_GATEWAY_DYNAMIC=false
# Host port mapping for mitmproxy (default: 8085; change to 8080 if needed for standard emulator proxy)
# MITMPROXY_PORT=8085

# ─── Dynamic analysis: pacing and evidence ────────────────────────────────────
# Raise the scale if the sandbox is slow and the app crashes under automation
# (2.0 = every UI delay doubled).
SUDARSHAN_ACTION_DELAY_SCALE=1.0
SUDARSHAN_APP_OPEN_SETTLE=8.0
# How long each sample is exercised. Raised from 90s once the investigation
# plan began driving the run: measured at ~4.2s per action, the fullest 14-stage plan at
# 4 actions per stage needs ~235s, and a 90s window truncated the walk at stage
# 3 of 11. Every dynamic run now costs ~5 minutes instead of ~90s.
FRIDA_ANALYSIS_DURATION=300

# Actions one investigation stage may spend before moving on, and the total
# across the run. The per-stage value bounds how long a single screen can hold
# the investigation; the total must exceed (stages x per-stage) or the plan
# cannot finish - at 25 and 4 the walk stopped after ~6 of 11 stages.
INVESTIGATION_MAX_ACTIONS_PER_GOAL=4
SUDARSHAN_AGENT_ACTION_BUDGET=60
# Set to 1 to skip runtime screenshots entirely. Leave unset: with it on, the
# dashboard evidence gallery is empty and the run looks like it failed.
# SUDARSHAN_DISABLE_SCREENSHOTS=
# Optional: override the detected screen resolution. Normally unnecessary -
# the real value is read from `adb shell wm size`. A WRONG value here makes the
# planner reject taps outside the assumed bounds, so leave both unset unless
# you are certain.
# SUDARSHAN_SCREEN_WIDTH=
# SUDARSHAN_SCREEN_HEIGHT=
#
# TIP - seeing the automated taps on screen
# The explorer drives the device with `adb shell input tap`, which leaves no
# visual trace. To watch the taps land, turn on the device's own overlay:
#   adb shell settings put system show_touches 1
#   adb shell settings put system pointer_location 1   # adds coordinates
# This is a per-emulator developer setting, not a project one - a teammate's
# fresh AVD has it off, which is why taps can look like they stopped happening.

# ─── Optional ─────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_EXPIRE_HOURS=12
MOBSF_HOST=
MOBSF_API_KEY=
# Shared secret between backend and analysis-engine (set in production).
ANALYSIS_ENGINE_INTERNAL_TOKEN=
# Required when SUDARSHAN_ENV=production (analysis-engine returns 503 without it)
# Set to production to enable stricter startup checks.
SUDARSHAN_ENV=
# Public signup: default true in dev; default false when SUDARSHAN_ENV=production
# SUDARSHAN_ALLOW_REGISTRATION=true
# Disable gateway rate limits during local pytest (optional).
SUDARSHAN_RATE_LIMIT_DISABLED=
