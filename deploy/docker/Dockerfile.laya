# SUDARSHAN — Laya Decision Engine Service
# Serves /v1/systemone for System-1 candidate action selection
# Compatible with TypeSafe Jev API wire format

FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HUB_ENABLE_HF_TRANSFER=0 \
    LAYA_PORT=8000 \
    LAYA_HOST=0.0.0.0

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch CPU and Laya with serve extras
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    torch \
    --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
    "laya==0.3.20" \
    "fastapi>=0.110.0" \
    "uvicorn>=0.27.0"

# Pre-create model cache directory for persistent volume mount
RUN mkdir -p /root/.cache/huggingface

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["uvicorn", "laya.serve:app", "--host", "0.0.0.0", "--port", "8000"]
