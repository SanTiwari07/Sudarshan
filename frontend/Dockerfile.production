# ── Stage 1: Build ─────────────────────────────────────────────────────────────
# Produces the optimised static bundle under /app/dist.
FROM node:18-alpine AS build

WORKDIR /app

# Install dependencies first so that the layer is cached when only source files
# change (not package.json / package-lock.json).
COPY package*.json ./
RUN npm ci

COPY . .

# VITE_API_URL must be baked in at build time; it becomes a string constant in
# the JS bundle and cannot be changed at runtime via env injection.  Pass it
# as a build arg and override the default (localhost dev fallback) for every
# non-local environment:
#
#   docker build --build-arg VITE_API_URL=https://api.example.com/api/v1 .
#
ARG VITE_API_URL=http://localhost:8000/api/v1
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# ── Stage 2: Serve ─────────────────────────────────────────────────────────────
# Minimal nginx image; only the compiled bundle is copied — no Node.js, no
# node_modules, no source files.
FROM nginx:1.27-alpine AS production

# Remove the default placeholder page.
RUN rm -rf /usr/share/nginx/html/*

# Copy the Vite output.
COPY --from=build /app/dist /usr/share/nginx/html

# SPA routing: every path that does not match a real file should fall through to
# index.html so the React Router can handle it client-side.
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
