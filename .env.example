# Copy to .env and fill in. .env is gitignored and must never be committed.

# ─── Required ─────────────────────────────────────────────────────────────────
# The backend refuses to start without this. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ─── Admin bootstrap ──────────────────────────────────────────────────────────
# Seeded on first boot only. If ADMIN_PASSWORD is left blank, a random password
# is generated and printed once to the backend log — capture it from there.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://host.docker.internal:11434

# ─── Threat intelligence (optional; correlation is skipped when unset) ────────
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_EXPIRE_HOURS=12
MOBSF_HOST=
SUDARSHAN_EXPLORER_MODE=hybrid
