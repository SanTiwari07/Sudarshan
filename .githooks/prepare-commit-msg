#!/bin/sh
# Remove Cursor agent attribution from commit messages (IDE/CLI/cloud co-author lines).
MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0
TMP="${MSG_FILE}.cursor-strip"
grep -vi 'cursoragent@cursor.com' "$MSG_FILE" | grep -vi '^co-authored-by: cursor' | grep -vi '^made-with: cursor' > "$TMP" || true
mv "$TMP" "$MSG_FILE"
